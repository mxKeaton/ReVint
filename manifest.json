{
  "manifest_version": 3,
  "name": "ReVint",
  "version": "1.0",
  "description": "Sichert eigene Vinted-Relistings lokal in der Erweiterung und füllt das Formular zum erneuten Einstellen aus.",
  "homepage_url": "https://github.com/mxKeaton/ReVint",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.vinted.net/*",
    "*://*.vinted.com/*",
    "*://*.vinted.co.uk/*",
    "*://*.vinted.ie/*",
    "*://*.vinted.de/*",
    "*://*.vinted.at/*",
    "*://*.vinted.be/*",
    "*://*.vinted.fr/*",
    "*://*.vinted.lu/*",
    "*://*.vinted.nl/*",
    "*://*.vinted.es/*",
    "*://*.vinted.it/*",
    "*://*.vinted.pl/*",
    "*://*.vinted.lt/*",
    "*://*.vinted.lv/*",
    "*://*.vinted.ee/*",
    "*://*.vinted.cz/*",
    "*://*.vinted.sk/*",
    "*://*.vinted.hu/*",
    "*://*.vinted.ro/*",
    "*://*.vinted.se/*",
    "*://*.vinted.dk/*",
    "*://*.vinted.fi/*",
    "*://*.vinted.pt/*",
    "*://*.vinted.gr/*",
    "*://*.vinted.hr/*",
    "*://*.vinted.bg/*",
    "*://*.vinted.si/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ReVint",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vinted.com/*",
        "*://*.vinted.co.uk/*",
        "*://*.vinted.ie/*",
        "*://*.vinted.de/*",
        "*://*.vinted.at/*",
        "*://*.vinted.be/*",
        "*://*.vinted.fr/*",
        "*://*.vinted.lu/*",
        "*://*.vinted.nl/*",
        "*://*.vinted.es/*",
        "*://*.vinted.it/*",
        "*://*.vinted.pl/*",
        "*://*.vinted.lt/*",
        "*://*.vinted.lv/*",
        "*://*.vinted.ee/*",
        "*://*.vinted.cz/*",
        "*://*.vinted.sk/*",
        "*://*.vinted.hu/*",
        "*://*.vinted.ro/*",
        "*://*.vinted.se/*",
        "*://*.vinted.dk/*",
        "*://*.vinted.fi/*",
        "*://*.vinted.pt/*",
        "*://*.vinted.gr/*",
        "*://*.vinted.hr/*",
        "*://*.vinted.bg/*",
        "*://*.vinted.si/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lang/*.json"
      ],
      "matches": [
        "*://*.vinted.com/*",
        "*://*.vinted.co.uk/*",
        "*://*.vinted.ie/*",
        "*://*.vinted.de/*",
        "*://*.vinted.at/*",
        "*://*.vinted.be/*",
        "*://*.vinted.fr/*",
        "*://*.vinted.lu/*",
        "*://*.vinted.nl/*",
        "*://*.vinted.es/*",
        "*://*.vinted.it/*",
        "*://*.vinted.pl/*",
        "*://*.vinted.lt/*",
        "*://*.vinted.lv/*",
        "*://*.vinted.ee/*",
        "*://*.vinted.cz/*",
        "*://*.vinted.sk/*",
        "*://*.vinted.hu/*",
        "*://*.vinted.ro/*",
        "*://*.vinted.se/*",
        "*://*.vinted.dk/*",
        "*://*.vinted.fi/*",
        "*://*.vinted.pt/*",
        "*://*.vinted.gr/*",
        "*://*.vinted.hr/*",
        "*://*.vinted.bg/*",
        "*://*.vinted.si/*"
      ]
    }
  ]
}
